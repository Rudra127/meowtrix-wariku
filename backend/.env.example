# Copy to `.env.dev` for `npm run dev` (and `.env.prod` for `npm run prod`). Never commit real values.

PORT=5947

# Local: `brew services start mongodb-community` then use the line below. Or a MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/wariku

# Clerk → Dashboard → Configure → API keys. Use the SAME Clerk application as the mobile app.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional: Clerk → Webhooks → endpoint → Signing Secret (see api/webhooks.js)
CLERK_WEBHOOK_SIGNING_SECRET=

# DeepSeek → https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Comma-separated browser origins allowed by CORS in production (native apps don't need this).
CLIENT_URLS=

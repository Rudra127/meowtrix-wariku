# Copy to `.env.dev` for `npm run dev` (and `.env.prod` for `npm run prod`). Never commit real values.

PORT=5947

# Local: `brew services start mongodb-community` then use the line below. Or a MongoDB Atlas URI.
# Always include the database name in the path (…mongodb.net/wariku), otherwise you get `test`.
MONGODB_URI=mongodb://127.0.0.1:27017/wariku

# Optional: use these DNS resolvers instead of the system's for MongoDB SRV lookups.
# Uncomment if you hit `querySrv EREFUSED` when connecting to Atlas.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Clerk → Dashboard → Configure → API keys. Use the SAME Clerk application as the mobile app.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional: Clerk → Webhooks → endpoint → Signing Secret (see api/webhooks.js)
CLERK_WEBHOOK_SIGNING_SECRET=

# DeepSeek → https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Speech-to-text (voice transaction entry) --------------------------------------------
# Any OpenAI-compatible POST {STT_BASE_URL}/audio/transcriptions endpoint works.
#   Groq   → STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3-turbo
#   OpenAI → STT_BASE_URL=https://api.openai.com/v1       STT_MODEL=gpt-4o-mini-transcribe
# Empty STT_API_KEY → POST /finance/voice returns 503 and the app hides the mic;
# the typed quick-add and POST /finance/parse keep working.
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# --- Brokerages (holdings for Ask AI) -----------------------------------------------------
# Connect ONE (or both). Holdings surface only through the Ask AI assistant, never a screen.
# The redirect URL must match the broker developer app exactly, and in dev must be the LAN IP the
# phone reaches the backend on, e.g. http://192.168.1.5:5947/api/v1/integrations/<provider>/callback

# Upstox — FREE, no monthly fee. https://account.upstox.com/developer/apps  (recommended)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://localhost:5947/api/v1/integrations/upstox/callback

# Zerodha Kite Connect — https://developers.kite.trade/apps (PAID developer app required).
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:5947/api/v1/integrations/zerodha/callback

# Encrypts broker access tokens at rest (AES-256-GCM). Required for any broker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every stored broker connection (users just reconnect).
ENCRYPTION_KEY=

# Deep link scheme the OAuth callback bounces back into (mobile/app.json → expo.scheme).
APP_SCHEME=wariku

# Groww Trading API — https://groww.in/trade-api (₹499 + tax / month, per Groww account).
#
# READ THIS FIRST: Groww has no OAuth and no redirect flow. All of its auth modes are the account
# holder authenticating for themselves, so ONE key pair = ONE portfolio for the whole server. It
# cannot show each user their own holdings. Use UPSTOX_* (free, real OAuth) for that.
#
# Generate the key + secret at https://groww.in → Settings → Trading APIs → Generate API key.
# Read-only here: Wariku only calls holdings/positions/prices, never the order endpoints.
GROWW_API_KEY=
GROWW_API_SECRET=
# Email of the Groww account holder. Only this signed-in user is shown the portfolio.
# Leave blank ONLY for a throwaway demo account: blank means every user sees these holdings.
GROWW_PORTFOLIO_OWNER_EMAIL=

# Comma-separated browser origins allowed by CORS in production (native apps don't need this).
CLIENT_URLS=

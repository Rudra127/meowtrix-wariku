    "@clerk/express": "^2.1.69",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.1",
    "multer": "2.4.0",
    "multer-s3": "^3.0.1",
    "stripe": "^18.3.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",

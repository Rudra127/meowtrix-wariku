{
  "name": "wariku-backend",
  "version": "1.0.0",
  "description": "Wariku API - Express + MongoDB + Clerk auth + DeepSeek",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon index.js",
    "start": "cross-env NODE_ENV=dev nodemon index.js",
    "prod": "cross-env NODE_ENV=prod node index.js",
    "test": "cross-env NODE_ENV=test node --test tests/*.test.js",
    "lint": "eslint .",
    "seed:learn": "cross-env NODE_ENV=dev node database/seed/seed-learn.js"

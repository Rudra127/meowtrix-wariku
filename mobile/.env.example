# Copy to `.env` (Expo loads it automatically; restart `npm start` after editing).
# Only EXPO_PUBLIC_* vars reach the app, and they are embedded in the bundle — never put secrets here.

# Clerk → Dashboard → Configure → API keys. Same Clerk application as backend/.env.dev.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Optional. In development the app auto-targets http://<your-computer's-LAN-IP>:5947/api/v1
# (the machine running Metro), which works for simulators and phones on the same Wi-Fi.
# Set this for tunnels (`expo start --tunnel`), a remote backend, and ALL production builds.
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1

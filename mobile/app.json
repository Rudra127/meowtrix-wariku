{
  "expo": {
    "name": "Wariku",
    "slug": "wariku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wariku.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Wariku uses your microphone so you can add expenses by speaking instead of typing."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F7EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wariku.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Wariku uses your microphone so you can add expenses by speaking instead of typing."
        }
      ],
      "expo-asset"
    ],
    "scheme": "wariku"
  }
}
